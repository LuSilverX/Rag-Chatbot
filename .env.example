# Copy to .env for local development. Never commit your real .env.
OPENAI_API_KEY=your-api-key
DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Production: set DEBUG=false, use a new strong secret and database password,
# and set the actual hostname/database connection. HTTPS is then required.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only when a trusted reverse proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false

# Portfolio demo budgets; fixed UTC windows, checked before billable requests.
DEMO_SESSION_HOURLY_LIMIT=10
DEMO_IP_HOURLY_LIMIT=30
DEMO_DAILY_LIMIT=100

# Temporary-workspace upload/replacement attempt budgets.
DEMO_UPLOAD_SESSION_HOURLY_LIMIT=5
DEMO_UPLOAD_IP_HOURLY_LIMIT=10
DEMO_UPLOAD_DAILY_LIMIT=30
