# Copy to .env.container. Local HTTP only; live HTTPS configuration is a later step.
OPENAI_API_KEY=replace-with-your-key
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Only use these settings when Django is reachable exclusively through our Nginx.
DJANGO_TRUST_PROXY=true
DJANGO_TRUST_CLIENT_IP=true
