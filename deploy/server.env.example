# Server-only .env.container; keep real secrets out of Git.
OPENAI_API_KEY=replace-with-your-key
DJANGO_SECRET_KEY=replace-with-a-generated-secret-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# Before public launch, add the public IP/domain to ALLOWED_HOSTS and its
# https:// address to CSRF_TRUSTED_ORIGINS (without a trailing slash).
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
WEB_WORKERS=1
