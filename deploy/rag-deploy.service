[Unit]
Description=Authenticated RAG deployment receiver
Requires=docker.service
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/rag-deploy/receiver.py
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
